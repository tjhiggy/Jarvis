# Required secrets and identifiers
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OPENAI_API_KEY=

# Safe defaults
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_RETRIES=1
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_MS=10000
WEB_SEARCH_CACHE_TTL_MS=3600000
WEB_SEARCH_MAX_RESULTS=5
OPENAI_MODEL=gpt-5.6-luna
MAX_HISTORY_MESSAGES=20
MAX_STORED_MESSAGES=10000
LOG_LEVEL=info
DATABASE_PATH=./data/discord-bot.db
# Trusted build identity. Set these during deployment; never derive them from Discord input.
JARVIS_VERSION=1.6.0
JARVIS_COMMIT_SHA=development
JARVIS_BUILD_TIMESTAMP=unknown
JARVIS_ENVIRONMENT=development
MAX_INPUT_CHARS=12000
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=3
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_CHANNEL_ID=
IMAGE_GENERATION_MODEL=gpt-image-1-mini
IMAGE_GENERATION_TIMEOUT_MS=60000
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_MS=60000
HISTORY_RETENTION_DAYS=30
PERSONA_PROMPT_PATH=./config/jarvis-persona.md
FAQ_CATALOG_PATH=./config/faq.json
# Optional read-only Sleeper league integration. Use the league ID from Sleeper.
SLEEPER_LEAGUE_ID=
# Optional repository-scoped GitHub integration. Both owner and repo are required.
# Leave GITHUB_TOKEN blank for public read-only lookup. The /feature-request
# workflow requires a fine-grained token limited to Issues: Read and write.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_TIMEOUT_MS=8000

# Optional anonymous polls. Leave both credentials blank to disable poll commands.
# When enabled, use comma-separated Discord administrator user IDs and a private 32+ character secret.
POLL_ADMIN_USER_IDS=
POLL_VOTER_SECRET=
POLL_RETENTION_DAYS=30
POLL_EXPIRY_CHECK_SECONDS=30

# Optional engagement platform. It remains disabled until explicitly enabled.
# Configure only the channels Jarvis may use, plus administrator role IDs.
ENGAGEMENT_ENABLED=false
ENGAGEMENT_INTRODUCTION_CHANNEL_ID=
ENGAGEMENT_SUGGESTION_CHANNEL_ID=
ENGAGEMENT_EVENT_CHANNEL_ID=
ENGAGEMENT_RECAP_CHANNEL_ID=
ENGAGEMENT_ACTIVITY_CHANNEL_ID=
ENGAGEMENT_BIRTHDAY_CHANNEL_ID=
# Optional self-service role menu: comma-separated value:label:roleId entries.
ENGAGEMENT_ROLE_MENU_OPTIONS=
ENGAGEMENT_ADMIN_ROLE_IDS=
# Weekly recap: DAY HH:MM (24-hour clock) and an IANA timezone.
ENGAGEMENT_RECAP_SCHEDULE=
ENGAGEMENT_RECAP_TIMEZONE=UTC
ENGAGEMENT_RETENTION_DAYS=30
ENGAGEMENT_MAX_RECORDS_PER_USER=5
ENGAGEMENT_MAX_PARTICIPANTS=100

# Optional comma-separated Discord channel IDs
ALLOWED_CHANNEL_IDS=
RESTRAINED_CHANNEL_IDS=

# Optional RSS monitoring (HTTPS host allowlist, comma-separated)
ENGAGEMENT_RSS_CHANNEL_ID=
ENGAGEMENT_RSS_ALLOWED_HOSTS=
# Optional administrator-approved proactive catalog. Blank disables proactive posts.
ENGAGEMENT_PROACTIVE_CATALOG_PATH=

# Optional quiet-channel nudges. Blank channel IDs disable that destination.
ENGAGEMENT_QUIET_NUDGE_EARTHLINGS_CHANNEL_ID=
ENGAGEMENT_QUIET_NUDGE_TEST_CHANNEL_ID=
ENGAGEMENT_QUIET_NUDGE_EARTHLINGS_WINDOW_MINUTES=1440
ENGAGEMENT_QUIET_NUDGE_TEST_WINDOW_MINUTES=5

# Optional local-only read-only Admin Console (disabled by default)
ADMIN_CONSOLE_ENABLED=false
ADMIN_CONSOLE_HOST=127.0.0.1
ADMIN_CONSOLE_PORT=8787
ADMIN_CONSOLE_TOKEN=
# Optional authenticated private Sites API. This is the read credential only.
# Generate a distinct 32+ character secret. Never reuse ADMIN_CONSOLE_TOKEN,
# which is the separate active-tab write credential. Blank values disable it.
COMMAND_DECK_API_TOKEN=
# Exact private Sites origin(s), comma-separated. HTTPS only, with no path,
# query, credentials, wildcard, or trailing slash. This also gates mutation CORS.
COMMAND_DECK_API_ALLOWED_ORIGINS=
COMMAND_DECK_API_RATE_LIMIT=30
COMMAND_DECK_API_WINDOW_SECONDS=60
COMMAND_DECK_API_MAX_CLOCK_SKEW_SECONDS=60
